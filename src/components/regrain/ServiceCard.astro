---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

const { title, description, href, icon } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition hover:border-slate-400 hover:shadow-md"
>
  {icon && (
    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 group-hover:bg-slate-600 group-hover:text-white transition">
      <svg class="h-5 w-5" aria-hidden="true">
        <use href={`#${icon}`} />
      </svg>
    </div>
  )}
  <h3 class="font-heading text-lg font-medium uppercase text-slate-800 group-hover:text-slate-600 transition">
    {title}
  </h3>
  <p class="text-sm text-slate-500 leading-relaxed">{description}</p>
  <span class="mt-auto text-sm font-medium text-slate-600 group-hover:text-slate-800">
    En savoir plus →
  </span>
</a>
