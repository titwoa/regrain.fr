---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { getCollection } from 'astro:content';

const metadata = { title: 'Blog & Veille — Regrain' };

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Infos & Blog"
    title="Actualités & Veille"
    subtitle="Veille réglementaire, sinistres structurels, météo & bâti, diagnostics — actualités du secteur de la construction et du diagnostic structurel."
  />

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="space-y-6">
      {posts.map((post) => {
        const dateStr = post.data.publishDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
        return (
          <a
            href={`/infos/blog/${post.id}`}
            class="group flex flex-col sm:flex-row gap-4 rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition hover:border-slate-400 hover:shadow-md"
          >
            <div class="flex-1">
              <div class="flex flex-wrap gap-2 mb-2">
                {post.data.tags?.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-500">{tag}</span>
                ))}
              </div>
              <h2 class="font-heading text-lg font-medium uppercase text-slate-800 group-hover:text-slate-600 transition mb-2">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-slate-500 leading-relaxed">{post.data.description}</p>
              )}
              <div class="mt-3 text-xs text-slate-400">{dateStr}</div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
