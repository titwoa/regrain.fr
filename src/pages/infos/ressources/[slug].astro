---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';

export async function getStaticPaths() {
  const ressources = await getCollection('ressources');
  return ressources.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, description, publishDate, author, tags, category, image } = entry.data;
const dateStr = publishDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout metadata={{ title }}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="mb-6">
      <a href="/infos/ressources" class="text-sm text-slate-500 hover:text-slate-700">← Retour aux ressources</a>
    </div>

    {image && (
      <div class="mb-6 overflow-hidden rounded-lg max-h-80 bg-slate-100 flex items-center justify-center">
        <button id="lightbox-trigger" class="focus:outline-none" title="Agrandir l'image" aria-label="Agrandir l'image">
          <Image src={image.src} alt={image.alt ?? title} class="max-h-80 w-auto object-contain hover:opacity-90 transition-opacity cursor-zoom-in" />
        </button>
      </div>

      <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 cursor-zoom-out p-4" role="dialog" aria-modal="true">
        <img id="lightbox-img" src="" alt={image.alt ?? title} class="max-h-full max-w-full object-contain rounded shadow-2xl" />
      </div>
    )}

    <script>
      function initLightbox() {
        const trigger = document.getElementById('lightbox-trigger');
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

        if (!trigger || !lightbox || !lightboxImg) return;

        const thumb = trigger.querySelector('img');

        trigger.addEventListener('click', () => {
          if (thumb) lightboxImg.src = thumb.src;
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
        });
        lightbox.addEventListener('click', () => {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
          }
        });
      }

      // Première visite directe
      initLightbox();
      // Navigation via View Transitions
      document.addEventListener('astro:page-load', initLightbox);
    </script>

    <div class="flex flex-wrap gap-2 mb-4">
      {category && <span class="rounded-full bg-slate-200 px-3 py-0.5 text-xs text-slate-700 font-medium">{category}</span>}
      {tags?.map((tag) => (
        <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs text-slate-500">{tag}</span>
      ))}
    </div>

    <h1 class="font-heading text-3xl font-medium uppercase text-slate-800 mb-4">{title}</h1>

    {description && (
      <p class="text-lg text-slate-500 mb-6 leading-relaxed">{description}</p>
    )}

    <div class="flex items-center gap-4 text-sm text-slate-400 mb-10 pb-6 border-b border-slate-100">
      <span>{dateStr}</span>
      {author && <span>Par {author}</span>}
    </div>

    <div class="prose prose-slate prose-headings:font-heading prose-headings:uppercase max-w-none">
      <Content />
    </div>
  </article>

  <CallToAction
    title="Besoin d'un diagnostic ?"
    subtitle="Notre équipe est disponible pour étudier votre situation."
    actions={[
      { variant: 'primary', text: 'Nous contacter', href: '/contact', icon: 'tabler:mail' },
    ]}
  />
</Layout>
